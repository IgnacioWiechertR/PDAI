              <li class="nav-item">
                <%= link_to "Eres nuevo? Registrate!", new_user_registration_path, class: "nav-link" %>
              </li>
              <li class="nav-item">
                <%= link_to "Ya tengo cuenta", new_user_session_path, class: "nav-link" %>
              </li>
            <% end %>
          </ul>
          </div>
      </div>
    </nav>
    <div class="container mt-4">
    <% flash.each do |key, message| %>
      <div class="alert <%= key == 'notice' ? 'alert-success' : 'alert-danger' %>" role="alert">
        <%= message %>
      </div>
    <% end %>

    </div>

    <%= yield %>
  </body>
</html>
