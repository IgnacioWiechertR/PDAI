<div class="bg-dark text-white min-vh-100 d-flex justify-content-center align-items-center">

  <div class="text-center">
    
    <%= link_to businesses_path, class: "d-block text-decoration-none mx-auto mb-4" do %>
      <div class="card shadow-sm mx-auto bg-secondary text-white border-0" style="width: 40rem;">
        <div class="card-body py-5">
          <h2 class="card-title mb-0 fw-bold">NEGOCIOS</h2>
        </div>
      </div>
    <% end %>

    <%= link_to items_path, class: "d-block text-decoration-none mx-auto mb-4" do %>
      <div class="card shadow-sm mx-auto bg-secondary text-white border-0" style="width: 40rem;">
        <div class="card-body py-5">
          <h2 class="card-title mb-0 fw-bold">ÍTEMS / MENÚ</h2>
        </div>
      </div>
    <% end %>

    <%= link_to shopping_carts_path, class: "d-block text-decoration-none mx-auto mb-4" do %>
      <div class="card shadow-sm mx-auto bg-secondary text-white border-0" style="width: 40rem;">
        <div class="card-body py-5">
          <h2 class="card-title mb-0 fw-bold">CARRITOS DE COMPRA</h2>
        </div>
      </div>
    <% end %>
    
  </div>
  
</div>