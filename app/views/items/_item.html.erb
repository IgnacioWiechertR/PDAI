<div id="<%= dom_id item %>">
  <p>
    <strong>Photo:</strong>
    <%= item.photo %>
  </p>

  <p>
    <strong>Name:</strong>
    <%= item.name %>
  </p>

  <p>
    <strong>Description:</strong>
    <%= item.description %>
  </p>

  <p>
    <strong>Categories:</strong>
    <%= item.categories %>
  </p>

  <p>
    <strong>Cost:</strong>
    <%= item.cost %>
  </p>

  <p>
    <strong>Owner:</strong>
    <%= item.owner_id %>
  </p>

</div>
