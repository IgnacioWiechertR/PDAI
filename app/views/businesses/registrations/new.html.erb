<h2>Sign up Business</h2>

<%= form_for(resource, as: resource_name, url: registration_path(resource_name)) do |f| %>
  <%= render "businesses/shared/error_messages", resource: resource %>

  <div class="field mb-3">
    <%= f.label :username %><br />
    <%= f.text_field :username, autofocus: true %>
  </div>

  <div class="field mb-3">
    <%= f.label :email %><br />
    <%= f.email_field :email %>
  </div>

  <div class="field mb-3">
    <%= f.label :comuna %><br />
    <%= f.text_field :comuna %>
  </div>

  <div class="field mb-3">
    <%= f.label :horario_inicio, "Horario de Inicio (Ej: 9)" %><br />
    <%= f.number_field :horario_inicio %>
  </div>

  <div class="field mb-3">
    <%= f.label :horario_termino, "Horario de Término (Ej: 18)" %><br />
    <%= f.number_field :horario_termino %>
  </div>

  <div class="field mb-3">
    <%= f.label :password %><br />
    <%= f.password_field :password, autocomplete: "new-password" %>
  </div>

  <%# ELIMINAMOS EL TEXT_FIELD LIBRE DE CATEGORÍA Y METEMOS LOS CHECKBOXES DE LOS TAGS OFICIALES %>
  <div class="field mb-3">
    <%= f.label :tag_ids, "Categorías del Negocio (Selecciona una o varias)", style: "display: block" %>
    <div class="tags-grid" style="display: grid; grid-template-columns: repeat(auto-fill, minmax(130px, 1fr)); gap: 10px; background: #222; padding: 15px; border-radius: 5px; border: 1px solid #444;">
      <%= f.collection_check_boxes :tag_ids, Tag.all, :id, :name do |b| %>
        <div class="tag-item" style="display: flex; align-items: center; gap: 8px; color: white;">
          <%= b.check_box %>
          <%= b.label style: "margin-bottom: 0; cursor: pointer;" %>
        </div>
      <% end %>
    </div>
  </div>

  <div class="actions">
    <%= f.submit "Sign up Business" %>
  </div>
<% end %>

<%= render "businesses/shared/links" %>